---
// Кнопка-посилання як Read More у Блоці 1: пунктирна рамка з текстом + помаранчевий квадрат зі стрілкою.
import RollText from './RollText.astro';
interface Props { href: string; label: string; back?: boolean }
const { href, label, back = false } = Astro.props;
---
<a class:list={['arrow-link', { 'arrow-link--back': back }]} href={href}>
  <span class="arrow-link__text"><RollText text={label} /></span>
  <span class="arrow-link__icon" aria-hidden="true">
    <svg viewBox="0 0 25 25" fill="currentColor"><path d="M16.85 13.54H4.17v-2.08h12.68L11.02 5.63l1.48-1.46 8.33 8.33-8.33 8.33-1.48-1.46 5.83-5.83Z" /></svg>
  </span>
</a>

<style>
  .arrow-link {
    display: inline-flex; gap: var(--space-xxs);
    font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
  }
  .arrow-link--back { flex-direction: row-reverse; }
  .arrow-link__text {
    display: flex; align-items: center; justify-content: center;
    width: var(--more-width); height: var(--control-height);
    border: 1px dashed var(--color-text-muted); border-radius: var(--radius-btn);
    transition: background-color var(--hover-duration) var(--ease-soft), border-color var(--hover-duration) var(--ease-soft), color var(--hover-duration) var(--ease-soft);
  }
  .arrow-link__icon {
    display: flex; align-items: center; justify-content: center;
    width: var(--control-height); height: var(--control-height);
    border-radius: var(--radius-btn); background: var(--color-accent); color: var(--color-bg); overflow: hidden;
  }
  .arrow-link__icon svg { width: var(--icon-m); height: var(--icon-m); transition: transform var(--duration) var(--ease); }
  .arrow-link--back .arrow-link__icon svg { transform: rotate(180deg); }
  .arrow-link:hover .arrow-link__text { background: var(--color-black); border-color: var(--color-black); color: var(--color-bg); }
  .arrow-link:hover .arrow-link__icon svg { animation: arrow-out var(--hover-duration) var(--ease-out); }
  .arrow-link--back:hover .arrow-link__icon svg { animation-name: arrow-out-back; }
  .arrow-link:focus-visible { outline: 2px solid var(--color-black); outline-offset: 3px; }

  /* Мобільні: кнопка на всю ширину, висота 60 */
  @media (max-width: 900px) {
    .arrow-link { display: flex; width: 100%; }
    .arrow-link__text { flex: 1; width: auto; height: var(--input-height); }
    .arrow-link__icon { width: var(--input-height); height: var(--input-height); }
  }
</style>
