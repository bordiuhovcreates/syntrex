---
// Блок 4 — відео на всю ширину, текст і цифри (Figma: Block 04).
// Відео вантажиться, коли блок наближається до екрана (data-video-src в interactive.js).
import home from '../content/home.json';
import { url } from '../lib/url';
import RollText from './RollText.astro';
const { stats } = home;
---
<section class="block4" id="block-4">
  <video
    class="block4__video" muted loop playsinline preload="none" aria-hidden="true"
    data-video-src={url(stats.video)} data-video-src-mob={url(stats.videoMobile || stats.video)}
    data-poster={url(stats.poster)} data-poster-mob={url(stats.posterMobile || stats.poster)}
  ></video>

  <h2 class="block4__title" data-anim="fade-up">{stats.title}</h2>

  <div class="block4__bottom">
    <a class="block4__more" href="#block-7" data-anim="fade-up">
      <span class="block4__more-text"><RollText text={stats.button} /></span>
      <span class="block4__more-icon" aria-hidden="true">
        <svg viewBox="0 0 25 25" fill="currentColor"><path d="M16.85 13.54H4.17v-2.08h12.68L11.02 5.63l1.48-1.46 8.33 8.33-8.33 8.33-1.48-1.46 5.83-5.83Z" /></svg>
      </span>
    </a>

    {stats.items.map((s) => (
      <div class="block4__stat" data-anim="fade-up">
        <span class="block4__number" data-count={s.number} data-suffix={s.suffix} data-separator data-roll>
          {s.number.toLocaleString('en-US')}{s.suffix}
        </span>
        <span class="block4__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .block4 {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    height: var(--block4-height); margin-top: var(--block-gap-l);
    padding: var(--space-60) var(--gutter) var(--space-28);
    overflow: hidden; color: var(--color-bg);
    background: var(--color-dark); /* поки вантажиться відео */
  }

  /* Відео з затемненням */
  .block4__video { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .block4::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--color-overlay); }
  .block4 { isolation: isolate; }

  .block4__title {
    max-width: var(--block4-title-width);
    font-size: var(--h2-size); line-height: var(--h2-lh); font-weight: var(--weight-regular);
    text-wrap: wrap;
  }

  /* Низ: кнопка зліва, картки з цифрами в колонках 3–4, як у сітці макета */
  .block4__bottom {
    display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: auto auto;
    gap: var(--space-sm); align-items: end;
  }
  .block4__stat:nth-of-type(1) { grid-column: 4; grid-row: 1; }
  .block4__stat:nth-of-type(2) { grid-column: 3; grid-row: 2; }
  .block4__stat:nth-of-type(3) { grid-column: 4; grid-row: 2; }

  /* Кнопка Get Quote (як Read More у Блоці 1, але світла) */
  .block4__more {
    grid-column: 1; grid-row: 2; justify-self: start;
    display: flex; gap: var(--space-xxs);
    margin-bottom: calc(var(--space-l) - var(--space-28));
    font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
  }
  .block4__more-text {
    display: flex; align-items: center; justify-content: center;
    width: var(--more-width); height: var(--control-height);
    border: 1px dashed var(--color-bg); border-radius: var(--radius-btn);
    transition: background-color var(--hover-duration) var(--ease-soft), border-color var(--hover-duration) var(--ease-soft), color var(--hover-duration) var(--ease-soft);
  }
  .block4__more-icon {
    display: flex; align-items: center; justify-content: center;
    width: var(--control-height); height: var(--control-height);
    border-radius: var(--radius-btn); background: var(--color-accent); color: var(--color-bg); overflow: hidden;
    transition: background-color var(--hover-duration) var(--ease-soft), color var(--hover-duration) var(--ease-soft);
  }
  .block4__more-icon svg { width: var(--icon-m); height: var(--icon-m); transition: transform var(--duration) var(--ease); }
  .block4__more:hover .block4__more-text { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); }
  .block4__more:hover .block4__more-icon { background: var(--color-bg); color: var(--color-black); }
  .block4__more:hover .block4__more-icon svg { animation: arrow-out var(--hover-duration) var(--ease-out); }
  .block4__more:focus-visible { outline: 2px solid var(--color-bg); outline-offset: 3px; }

  /* Картка з цифрою: темне скло, як на попередній версії сайту */
  .block4__stat {
    position: relative; display: flex; flex-direction: column; justify-content: space-between;
    height: var(--stat-card-height); padding: var(--space-xs) var(--space-sm) var(--space-sm);
    border-radius: var(--radius-card); background: var(--glass-bg);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
    backdrop-filter: blur(var(--glass-blur)) saturate(120%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(120%);
  }
  .block4__stat::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: calc(var(--space-sm) * 2 + var(--h4-size) * var(--h4-lh));
    border-top: 1px dashed var(--glass-divider);
  }
  .block4__number { font-size: var(--h2-size); line-height: var(--h2-lh); font-weight: var(--weight-medium); font-variant-numeric: tabular-nums; }
  .block4__label { align-self: flex-end; font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium); }

  /* Мобільні й планшет (Figma: mobile, 4 section): текст, три картки цифр одна під одною, кнопка внизу */
  @media (max-width: 900px) {
    .block4 { display: block; height: auto; margin-top: var(--space-xl); padding: var(--space-l) var(--gutter); }
    .block4__title { max-width: none; }
    .block4__bottom { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-xs); margin-top: var(--space-l); }
    .block4__more { justify-self: auto; }
    .block4__stat:nth-of-type(n) { grid-column: auto; grid-row: auto; }
    .block4__more { order: 2; margin: var(--space-l) 0 0; }
    .block4__more-text { flex: 1; width: auto; height: var(--input-height); }
    .block4__more-icon { width: var(--input-height); height: var(--input-height); }
    .block4__stat { padding: var(--space-xs) var(--space-sm) var(--space-sm); }
    .block4__stat::after { bottom: calc(var(--space-sm) * 2 + var(--caption-size)); }
    .block4__number { font-weight: var(--weight-regular); }
    .block4__label { font-size: var(--caption-size); }
  }
</style>
