---
// Юридична сторінка (Privacy Policy, Terms of Use) — як на ana-sol.com, але в нашому стилі:
// усе по лівому краю, великий заголовок, під ним дата оновлення і один широкий блок тексту.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import legal from '../content/legal.json';
import settings from '../content/settings.json';
import { getEntry, render } from 'astro:content';

interface Props { id: string }
const entry = await getEntry('legal', Astro.props.id);
if (!entry) throw new Error(`Немає сторінки src/content/legal/${Astro.props.id}.md`);
const { title, description, updated } = entry.data;
const { Content } = await render(entry);
const date = updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Base title={`${title} — ${settings.header.logo}`} description={description}>
  <Header />
  <main class="legal">
    <h1 class="legal__title" data-anim="fade-up">{title}</h1>
    <p class="legal__updated" data-anim="fade-up">{legal.updated} {date}</p>
    <article class="legal__prose">
      <Content />
    </article>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    /* меню (40 + 70) + 100 повітря, як у статтях */
    padding: calc(var(--space-l) + var(--control-height) + var(--space-xl)) var(--gutter) 0;
    font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
  }
  .legal__title { font-size: var(--h2-size); line-height: var(--h2-lh); font-weight: var(--weight-regular); }
  .legal__updated { margin-top: var(--space-m); color: var(--color-text-muted); }

  /* Відступи як на сайті: заголовок → дата 30, дата → текст 100, між розділами 60, заголовок розділу → текст 20, між абзацами 20.
     Один широкий блок тексту на три колонки сітки, без кольорових акцентів — лише чорний і сірий */
  .legal__prose {
    max-width: var(--legal-text-width); margin-top: var(--space-xl);
    font-size: var(--article-size); line-height: var(--article-lh); font-weight: var(--weight-regular);
  }
  .legal__prose > :global(* + *) { margin-top: var(--space-sm); }
  .legal__prose :global(h2) {
    margin-top: var(--space-60);
    font-size: var(--h3-size); line-height: var(--h3-lh); font-weight: var(--weight-medium);
  }
  .legal__prose :global(h2 + *) { margin-top: var(--space-sm); }
  .legal__prose :global(strong) { font-weight: var(--weight-bold); }
  .legal__prose :global(a) { text-decoration: underline; text-underline-offset: 0.2em; transition: color var(--duration) var(--ease); }
  .legal__prose :global(a:hover) { color: var(--color-text-muted); }
  .legal__prose :global(ul) { list-style: none; padding: 0; }
  .legal__prose :global(li) { position: relative; padding-left: var(--space-m); }
  .legal__prose :global(li + li) { margin-top: var(--space-xs); }
  .legal__prose :global(li::before) { content: '—'; position: absolute; left: 0; }

  /* Мобільні й планшет: відступ під шапку 80 px, менші проміжки, довгі слова й посилання переносяться */
  @media (max-width: 900px) {
    .legal { padding-top: calc(var(--header-height) + var(--space-l)); }
    .legal__title { overflow-wrap: break-word; hyphens: auto; text-wrap: balance; }
    .legal__updated { margin-top: var(--space-s); }
    .legal__prose { max-width: none; margin-top: var(--space-l); overflow-wrap: break-word; }
    .legal__prose :global(h2) { margin-top: var(--space-l); }
    .legal__prose :global(li) { padding-left: var(--space-sm); }
    .legal__prose :global(table), .legal__prose :global(pre) { display: block; max-width: 100%; overflow-x: auto; }
  }
</style>
