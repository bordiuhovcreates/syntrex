---
// Блок 5 — переваги (Figma: Block 05).
import home from '../content/home.json';
import { url } from '../lib/url';
const { perks } = home;
---
<section class="block5" id="block-5">
  <div class="block5__head">
    <p class="block5__label" data-anim="fade-up">{perks.label}</p>
    <h2 class="block5__title" data-anim="fade-up">{perks.title}</h2>
  </div>

  <ul class="block5__list" role="list" data-anim="stagger">
    {perks.items.map((item) => (
      <li class="block5__item">
        <span class="block5__icon">
          {item.icon && <img src={url(item.icon)} alt="" loading="lazy" width="50" height="50" />}
        </span>
        <span class="block5__body">
          <h3 class="block5__name">{item.title}</h3>
          <p class="block5__text">{item.text}</p>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .block5 { padding-top: var(--block-gap-l); }

  .block5__head { padding-inline: var(--gutter); }
  .block5__label { color: var(--color-accent); font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium); }
  .block5__title {
    margin-top: var(--space-m);
    font-size: var(--h2-size); line-height: var(--h2-lh); font-weight: var(--weight-regular);
  }

  /* Три колонки на всю ширину екрана, розділені пунктиром */
  .block5__list {
    display: grid; grid-template-columns: repeat(3, 1fr); margin-top: var(--space-xl);
    border-block: 1px dashed var(--color-text-muted);
  }
  .block5__item {
    display: flex; flex-direction: column; justify-content: space-between;
    height: var(--perk-height); padding: var(--space-l);
  }
  .block5__item + .block5__item { border-left: 1px dashed var(--color-text-muted); }

  .block5__icon {
    display: flex; align-items: center; justify-content: center;
    width: var(--perk-icon-box); height: var(--perk-icon-box);
    border-radius: var(--radius-btn); background: var(--color-accent);
  }
  .block5__icon img { width: var(--perk-icon); height: var(--perk-icon); transition: transform var(--hover-duration) var(--ease); }
  /* Наведення на картку: біла іконка в помаранчевому квадраті легко збільшується */
  .block5__item:hover .block5__icon img { transform: scale(1.15); }

  .block5__name { font-size: var(--h3-size); line-height: var(--h3-lh); font-weight: var(--weight-medium); }
  /* Тексти підібрані під цю ширину: 4 рівні рядки */
  .block5__text {
    max-width: var(--perk-text-width); margin-top: var(--space-m);
    font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
    text-wrap: wrap;
  }

  /* Мобільні й планшет (Figma: mobile, 5 section): переваги одна під одною, пунктир між ними на всю ширину */
  @media (max-width: 900px) {
    .block5 { padding-top: var(--space-xl); }
    .block5__title { margin-top: var(--space-sm); }
    .block5__list { display: block; margin-top: var(--space-50); }
    .block5__item { height: auto; padding: var(--space-l) var(--gutter); }
    .block5__item + .block5__item { border-left: 0; border-top: 1px dashed var(--color-text-muted); }
    .block5__body { margin-top: var(--space-l); }
    /* вужчий текст, як у макеті (288–294 px): більше повітря справа, короткі слова переходять на новий рядок */
    .block5__text { max-width: var(--perk-text-mobile-width); margin-top: var(--space-sm); font-size: var(--caption-size); }
  }
</style>
