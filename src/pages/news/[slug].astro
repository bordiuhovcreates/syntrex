---
// Сторінка статті: шапка за сіткою (тема │ заголовок │ дата і час читання), пунктир, далі опис і текст у колонках 2–3.
// Обкладинка (cover) не показується на сторінці — лише як картинка для соцмереж.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import blog from '../../content/blog.json';
import settings from '../../content/settings.json';
import { render } from 'astro:content';
import { url } from '../../lib/url';
import { getNews, readTime, formatDate, type Post } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, category, date, image, cover } = post.data;
const { Content } = await render(post);
---
<Base title={`${title} — ${settings.header.logo}`} description={description} image={cover || image}>
  <Header />
  <div class="art-progress" aria-hidden="true"><span data-progress></span></div>
  <main class="art">
    <header class="art__head">
      <p class="art__cat" data-anim="fade-up">{category}</p>
      <h1 class="art__title" data-anim="fade-up">{title}</h1>
      <div class="art__chips" data-anim="fade-up">
        <span class="art__chip">{formatDate(date)}</span>
        <span class="art__chip">{readTime(post)} {blog.minRead}</span>
      </div>
    </header>

    <div class="art__body">
      <p class="art__lead" data-anim="fade-up">{description}</p>
      <article class="art__prose" data-article>
        <Content />
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .art {
    /* меню (40 + 70) + 100 повітря до шапки статті */
    padding: calc(var(--space-l) + var(--control-height) + var(--space-xl)) var(--gutter) 0;
    font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
  }
  /* Смуга прогресу читання */
  .art-progress { position: fixed; inset: 0 0 auto 0; z-index: 60; height: var(--progress-height); pointer-events: none; }
  .art-progress span { display: block; height: 100%; background: var(--color-accent); transform: scaleX(0); transform-origin: left; }

  /* Шапка статті за сіткою з 4 колонок: тема │ заголовок (2–3) │ дата і час читання.
     Знизу пунктир на всю ширину екрана, як у футері */
  .art__head {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); align-items: start;
    margin-inline: calc(var(--gutter) * -1); padding: 0 var(--gutter) var(--space-xl);
    border-bottom: 1px dashed var(--color-text-muted);
  }
  .art__cat { color: var(--color-accent); }
  .art__title { grid-column: 2 / 4; font-size: var(--h2-size); line-height: var(--h2-lh); font-weight: var(--weight-regular); text-wrap: balance; }
  .art__chips { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-xs); }
  .art__chip {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    height: var(--input-height); padding: 0 var(--space-m);
    border: 1px dashed var(--color-text-muted); border-radius: var(--radius-btn); white-space: nowrap;
  }
  .art__chip::before { content: ''; width: var(--dot-size); height: var(--dot-size); border-radius: 50%; background: var(--color-accent); }

  /* Текст — у колонках 2–3, рівно під заголовком; відступ від лінії — як усередині блоків */
  .art__body { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); margin-top: var(--space-xl); }
  .art__lead, .art__prose { grid-column: 2 / 4; }
  .art__lead { max-width: var(--article-width); font-size: var(--h3-size); line-height: 1.25; color: var(--color-text-muted); text-wrap: pretty; }

  /* Типографіка статті */
  .art__prose {
    margin-top: var(--space-l); max-width: var(--article-width);
    font-size: var(--article-size); line-height: var(--article-lh); font-weight: var(--weight-regular);
  }
  .art__prose > :global(* + *) { margin-top: var(--space-sm); }
  .art__prose :global(h2) {
    margin-top: var(--space-xl); font-size: var(--h3-size); line-height: var(--h3-lh); font-weight: var(--weight-medium); text-wrap: balance;
  }
  .art__prose :global(h2 + *) { margin-top: var(--space-m); }
  .art__prose :global(strong) { font-weight: var(--weight-bold); }
  .art__prose :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .art__prose :global(ul), .art__prose :global(ol) { padding-left: var(--space-m); }
  .art__prose :global(li + li) { margin-top: var(--space-xs); }
  .art__prose :global(li::marker) { color: var(--color-accent); }
  /* Фото в тексті: на всю ширину колонок 2–3 (ширше за текст), заокруглення як у картках, підпис сірим */
  .art__prose :global(figure) { width: var(--article-col-width); max-width: none; margin-block: var(--space-xl); }
  .art__prose :global(figure img) { display: block; width: 100%; height: var(--article-photo-height); object-fit: cover; border-radius: var(--radius-card); }
  .art__prose :global(figcaption) {
    margin-top: var(--space-sm); font-size: var(--h4-size); line-height: var(--h4-lh); font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  /* Цитата: пунктир зверху і знизу, як скрізь на сайті */
  .art__prose :global(blockquote) {
    margin-block: var(--space-60); padding-block: var(--space-m);
    border-block: 1px dashed var(--color-text-muted);
    font-size: var(--h3-size); line-height: 1.25; font-weight: var(--weight-medium); text-wrap: balance;
  }

  @media (max-width: 900px) {
    .art__head, .art__body { grid-template-columns: 1fr; }
    .art__title, .art__lead, .art__prose { grid-column: auto; }
    .art__chips { justify-content: flex-start; }

    /* Мобільна шапка: 80 px + повітря до заголовка */
    .art { padding-top: calc(var(--header-height) + var(--space-l)); }
    .art__head { gap: var(--space-s); padding-bottom: var(--space-l); }
    .art__title { min-width: 0; overflow-wrap: break-word; hyphens: auto; }
    .art__chip { height: var(--chip-height); padding: 0 var(--space-s); }
    .art__body { margin-top: var(--space-l); }
    .art__lead, .art__prose { max-width: none; min-width: 0; }
    .art__prose { margin-top: var(--space-m); overflow-wrap: break-word; }
    .art__prose :global(h2) { margin-top: var(--space-60); }
    .art__prose :global(h2 + *) { margin-top: var(--space-sm); }
    .art__prose :global(ul), .art__prose :global(ol) { padding-left: var(--space-sm); }
    .art__prose :global(figure) { margin-block: var(--space-l); }
    .art__prose :global(figcaption) { margin-top: var(--space-xs); font-size: var(--small-size); line-height: 1.3; }
    .art__prose :global(blockquote) { margin-block: var(--space-l); padding-block: var(--space-sm); }
    .art__prose :global(img), .art__prose :global(table), .art__prose :global(pre) { max-width: 100%; }
    .art__prose :global(pre) { overflow-x: auto; }
  }
</style>

<script>
  // Прогрес читання: смуга вгорі заповнюється від початку до кінця тексту статті
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  const progress = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.5;
    const done = Math.min(1, Math.max(0, (window.innerHeight * 0.5 - r.top) / total));
    bar.style.transform = `scaleX(${done})`;
  };
  window.addEventListener('scroll', progress, { passive: true });
  window.addEventListener('resize', progress);
  progress();
</script>
